// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`database-schema render produces valid HTML with semantic theme classes 1`] = `
"<section id="database-schema" class="my-12">
  <h2 class="font-display text-3xl font-bold text-foreground mb-6">Database schema</h2>
  <div class="grid gap-6 grid-cols-1 lg:grid-cols-2">
  <div class="rounded-card bg-surface shadow-card ring-1 ring-muted/40 overflow-hidden">
    <div class="flex items-center justify-between gap-3 px-5 py-4 border-b border-muted/40">
      <div class="flex items-center gap-3 min-w-0">
        <i data-lucide="table" class="h-5 w-5 text-muted-foreground shrink-0"></i>
        <h3 class="font-display text-xl font-bold text-foreground font-mono truncate">users</h3>
      </div>
      <span class="inline-flex shrink-0 text-xs px-2.5 py-1 rounded-full ring-1 font-medium uppercase tracking-wider bg-primary/10 text-primary ring-primary/30">SQL</span>
    </div>
    <p class="px-5 pt-4 pb-2 text-sm text-muted-foreground leading-relaxed">Stores accounts</p>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-muted/50 bg-muted/20">
            <th class="px-4 py-2 text-left font-display font-semibold text-foreground">Field</th>
            <th class="px-4 py-2 text-left font-display font-semibold text-foreground">Type</th>
            <th class="px-4 py-2 text-left font-display font-semibold text-foreground">Notes</th>
          </tr>
        </thead>
        <tbody>
        <tr class="border-b border-muted/30 last:border-0 hover:bg-muted/10">
          <td class="px-4 py-2 font-mono text-sm font-medium text-foreground">id</td>
          <td class="px-4 py-2 font-mono text-sm text-primary">uuid</td>
          <td class="px-4 py-2 text-sm text-muted-foreground">Primary key</td>
        </tr>
        </tbody>
      </table>
    </div>
  </div>
  </div>
</section>"
`;
