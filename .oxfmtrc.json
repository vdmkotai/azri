{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortPackageJson": true,
  "sortImports": { "partitionByNewline": true, "newlinesBetween": false },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    ".sisyphus/",
    "azri-out/",
    "evals/runs/",
    "pages-data/",
    "test/fixtures/README.md",
    "test/fixtures/azri-output.json",
    "test/fixtures/pr-input.json",
    "test/fixtures/stage0-input.json",
    "test/fixtures/stage1-output.json",
    "test/fixtures/test-private-key.pem",
    "examples/*.html",
    "azri-explainer.html"
  ]
}
