# GitHub App ID for webhook authentication.
GITHUB_APP_ID=

# GitHub App private key (PEM).
GITHUB_PRIVATE_KEY=

# Primary GitHub webhook secret.
GITHUB_WEBHOOK_SECRET=

# Additional webhook secrets, comma-separated.
AZRI_WEBHOOK_SECRETS_ADDITIONAL=

# Default LLM provider.
AZRI_LLM_PROVIDER=anthropic

# Anthropic API key.
ANTHROPIC_API_KEY=

# OpenAI API key.
OPENAI_API_KEY=

# Google API key.
GOOGLE_API_KEY=

# Local data directory.
AZRI_DATA_DIR=/data

# Public base URL.
AZRI_PUBLIC_BASE_URL=https://azri.example.com

# Log level.
AZRI_LOG_LEVEL=info

# Disable self-bootstrap by default.
AZRI_SELF_BOOTSTRAP=false
